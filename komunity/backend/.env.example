# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/komunity

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
# Signs email unsubscribe links (falls back to JWT_SECRET if unset)
UNSUBSCRIBE_SECRET=
# Set false only for single-origin HTTP testing; true (default in prod) requires HTTPS
COOKIE_SECURE=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Storage (AWS S3 / Cloudflare R2)
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=komunity-media
S3_PUBLIC_URL=https://assets.komunity.app

# Video (Mux)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Video Calls (Daily.co)
DAILY_API_KEY=
DAILY_WEBHOOK_SECRET=

# AI (Gemini — moderation, summaries, course outlines)
GEMINI_API_KEY=

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@komunity.app

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Frontend URL (for CORS + password reset emails)
FRONTEND_URL=http://localhost:5173

